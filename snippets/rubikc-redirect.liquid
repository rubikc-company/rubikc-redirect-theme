{%- comment -%}
  Content pages redirect to the Rubikc storefront URL.
  The cart page redirects too. Account, checkout, policies, gift cards, and Shopify checkpoints stay on this theme.
  Shopify cart permalinks arrive as /cart?cart_link_id=… The storefront cannot reload products from that id, so the cart page reads the Shopify cart and continues to /cart/variant:quantity.
{%- endcomment -%}

{%- if part == 'style' -%}
  <style>html.rubikc-redirecting{visibility:hidden}</style>
{%- elsif part == 'script' -%}
  <script>
    /* @rubikc-redirect */
    function rubikcReadCookie(cookieHeader, name) {
      var parts = String(cookieHeader || '').split(';');
      var prefix = name + '=';

      for (var i = 0; i < parts.length; i++) {
        var cookie = parts[i].trim();
        if (cookie.indexOf(prefix) === 0) {
          var value = cookie.substring(prefix.length);
          try {
            return decodeURIComponent(value);
          } catch (error) {
            return value;
          }
        }
      }

      return '';
    }

    function rubikcPathSegments(pathname) {
      var parts = String(pathname || '/').split('/');
      var index = 1;

      if (parts[1] && /^[a-z]{2,3}(-[a-zA-Z]{2})?$/i.test(parts[1])) {
        index = 2;
      }

      return parts.slice(index);
    }

    function rubikcIsCartPage(pathname) {
      var segments = rubikcPathSegments(pathname).filter(function (segment) {
        return segment !== '';
      });

      return segments.length === 1 && segments[0] === 'cart';
    }

    function rubikcIsEssentialPath(pathname) {
      var segment = rubikcPathSegments(pathname)[0] || '';
      var essential = {
        account: true,
        checkout: true,
        checkouts: true,
        challenge: true,
        checkpoint: true,
        throttle: true,
        apps: true,
        a: true,
        community: true,
        tools: true,
        discount: true,
        policies: true,
        gift_cards: true
      };

      if (segment === 'cart') {
        return !rubikcIsCartPage(pathname);
      }

      return !!essential[segment];
    }

    function rubikcIsProductPath(pathname) {
      return rubikcPathSegments(pathname)[0] === 'products';
    }

    function rubikcNormalizeTarget(redirectTarget) {
      var target = String(redirectTarget || '').trim();
      if (!target) return '';

      if (target.indexOf('//') === 0) {
        target = 'https:' + target;
      } else if (!/^https?:\/\//i.test(target)) {
        target = 'https://' + target;
      }

      var targetUrl;
      try {
        targetUrl = new URL(target);
      } catch (error) {
        return '';
      }

      if (targetUrl.protocol !== 'http:' && targetUrl.protocol !== 'https:') return '';
      if (!targetUrl.hostname) return '';

      var basePath = targetUrl.pathname.replace(/\/$/, '');
      if (basePath === '/') basePath = '';

      return targetUrl.origin + basePath;
    }

    function rubikcResolveRedirect(input) {
      var redirectBase = rubikcNormalizeTarget(input.redirectTarget);
      var search = input.search || '';
      var params = new URLSearchParams(search.charAt(0) === '?' ? search.slice(1) : search);
      var shopifyPreview = !!(
        input.designMode ||
        input.visualPreviewMode ||
        params.has('preview_theme_id')
      );

      if (!redirectBase || shopifyPreview) {
        return {
          redirect: false,
          preview: shopifyPreview,
          target: redirectBase
        };
      }

      var clearStay = false;
      var stayStored = !!input.stayStored;

      if (params.get('rubikc_stay_old') === '0') {
        clearStay = true;
        stayStored = false;
      } else if (params.has('rubikc_stay_old') || stayStored) {
        return {
          redirect: false,
          clearStay: false,
          storeStay: params.has('rubikc_stay_old')
        };
      }

      if (rubikcIsEssentialPath(input.pathname)) {
        return { redirect: false, clearStay: clearStay };
      }

      var targetUrl = new URL(redirectBase);

      if (String(input.hostname || '').toLowerCase() === targetUrl.hostname.toLowerCase()) {
        return { redirect: false, clearStay: clearStay };
      }

      var hash = input.hash || '';
      if (!hash && rubikcIsProductPath(input.pathname)) {
        hash = '#content-1';
      }

      var basePath = targetUrl.pathname.replace(/\/$/, '');
      if (basePath === '/') basePath = '';

      var destination = new URL(targetUrl.origin + basePath + (input.pathname || '/'));
      destination.search = search;
      destination.searchParams.delete('rubikc_stay_old');
      if (hash) destination.hash = hash;

      var discountCode = rubikcReadCookie(input.cookie, 'discount_code');
      var clearDiscountCookie = false;
      if (discountCode && !destination.searchParams.has('discount')) {
        destination.searchParams.append('discount', discountCode);
        clearDiscountCookie = true;
      }

      return {
        redirect: true,
        url: destination.toString(),
        clearDiscountCookie: clearDiscountCookie,
        clearStay: clearStay
      };
    }

    function rubikcShouldRecoverCartLink(pathname, search) {
      if (!rubikcIsCartPage(pathname)) return false;

      var params = new URLSearchParams(String(search || '').replace(/^\?/, ''));
      return !!params.get('cart_link_id');
    }

    function rubikcCartPermalinkToken(items) {
      if (!items || !items.length) return '';

      var parts = [];

      for (var i = 0; i < items.length && parts.length < 50; i++) {
        var item = items[i] || {};
        var id = String(item.variant_id || item.id || '');
        var quantity = parseInt(item.quantity, 10);

        if (!/^\d{1,20}$/.test(id)) continue;
        if (!isFinite(quantity) || quantity < 1) continue;
        if (quantity > 10000) quantity = 10000;

        parts.push(id + ':' + quantity);
      }

      return parts.join(',');
    }

    function rubikcEncodeBase64Url(value) {
      try {
        return btoa(unescape(encodeURIComponent(value)))
          .replace(/\+/g, '-')
          .replace(/\//g, '_')
          .replace(/=+$/g, '');
      } catch (error) {
        return '';
      }
    }

    function rubikcEncodeLineProperties(properties) {
      if (!properties || typeof properties !== 'object') return '';

      var encoded = {};
      var count = 0;
      var entries = Array.isArray(properties) ? properties : Object.keys(properties);

      for (var i = 0; i < entries.length && count < 25; i++) {
        var key = '';
        var value;

        if (Array.isArray(properties)) {
          var property = entries[i] || {};
          key = String(property.name || property.key || '').trim();
          value = property.value;
        } else {
          key = String(entries[i] || '').trim();
          value = properties[entries[i]];
        }

        if (!key || /[[\]\r\n]/.test(key) || value == null || value === '') continue;
        if (typeof value === 'object') continue;

        encoded[key] = String(value);
        count++;
      }

      if (!count) return '';

      var token = rubikcEncodeBase64Url(JSON.stringify(encoded));
      if (!token || token.length > 2000) return '';

      return token;
    }

    function rubikcRecoverCartLinkUrl(url, cart) {
      var token = rubikcCartPermalinkToken(cart && cart.items);
      if (!token) return url;

      var destination;

      try {
        destination = new URL(url);
      } catch (error) {
        return url;
      }

      if (!destination.searchParams.get('cart_link_id')) return url;

      var pathMatch = destination.pathname.match(/^(.*)\/cart\/?$/);
      if (!pathMatch) return url;

      destination.pathname = pathMatch[1] + '/cart/' + token;
      destination.searchParams.delete('cart_link_id');

      var attributes = cart.attributes || {};
      var attributeNames = Object.keys(attributes);
      var addedAttributes = 0;

      for (var i = 0; i < attributeNames.length && addedAttributes < 25; i++) {
        var name = String(attributeNames[i] || '').trim();
        var attributeValue = attributes[attributeNames[i]];

        if (!name || /[[\]\r\n]/.test(name) || attributeValue == null || attributeValue === '') continue;

        var paramName = 'attributes[' + name + ']';
        if (destination.searchParams.has(paramName)) continue;

        destination.searchParams.append(paramName, String(attributeValue));
        addedAttributes++;
      }

      if (cart.note && !destination.searchParams.has('note')) {
        var note = String(cart.note);
        if (note.length <= 5000) destination.searchParams.append('note', note);
      }

      if (!destination.searchParams.has('discount') && cart.discount_codes && cart.discount_codes.length) {
        var codes = [];

        for (var d = 0; d < cart.discount_codes.length && codes.length < 10; d++) {
          var discount = cart.discount_codes[d];
          var code = discount && typeof discount === 'object' ? discount.code : discount;

          if (discount && discount.applicable === false) continue;
          if (!code) continue;

          codes.push(String(code));
        }

        if (codes.length) destination.searchParams.append('discount', codes.join(','));
      }

      if (!destination.searchParams.has('properties') && cart.items && cart.items[0]) {
        var properties = rubikcEncodeLineProperties(cart.items[0].properties);
        if (properties) destination.searchParams.append('properties', properties);
      }

      return destination.toString();
    }
    /* @rubikc-redirect-end */

    var rubikcShopifyCart = {%- if request.page_type == 'cart' -%}
      {
        "note": {{ cart.note | json }},
        "attributes": {{ cart.attributes | json }},
        "items": [
          {%- for item in cart.items -%}
            {
              "variant_id": {{ item.variant_id | json }},
              "quantity": {{ item.quantity | json }},
              "properties": {{ item.properties | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "discount_codes": [
          {%- assign rubikc_discount_sep = '' -%}
          {%- for discount in cart.discount_applications -%}
            {%- if discount.type == 'discount_code' -%}
              {{ rubikc_discount_sep }}{"code": {{ discount.title | json }}}
              {%- assign rubikc_discount_sep = ',' -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    {%- else -%}
      null
    {%- endif -%};

    (function () {
      function reveal() {
        document.documentElement.classList.remove('rubikc-redirecting');
      }

      var stayStored = false;
      try {
        stayStored = window.sessionStorage.getItem('rubikc_stay_old') === '1';
      } catch (error) {
        stayStored = false;
      }

      var decision;
      try {
        decision = rubikcResolveRedirect({
          redirectTarget: {{ settings.redirect_url | json }},
          pathname: window.location.pathname,
          search: window.location.search,
          hash: window.location.hash,
          hostname: window.location.hostname,
          cookie: document.cookie,
          designMode: !!(window.Shopify && window.Shopify.designMode),
          visualPreviewMode: !!(window.Shopify && window.Shopify.visualPreviewMode),
          stayStored: stayStored
        });
      } catch (error) {
        reveal();
        return;
      }

      try {
        if (decision.clearStay) window.sessionStorage.removeItem('rubikc_stay_old');
        if (decision.storeStay) window.sessionStorage.setItem('rubikc_stay_old', '1');
      } catch (error) {}

      if (decision.preview) {
        var previewText = decision.target ? 'Rubikc Redirect: ' + decision.target : 'Rubikc Redirect';
        var showPreview = function () {
          document.title = previewText;
          if (document.body) document.body.textContent = previewText;
          reveal();
        };
        if (document.body) showPreview();
        else document.addEventListener('DOMContentLoaded', showPreview);
        return;
      }

      if (!decision.redirect) {
        reveal();
        return;
      }

      function leave(next) {
        if (next.clearDiscountCookie) {
          document.cookie = 'discount_code=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT; SameSite=Lax';
        }

        window.location.replace(next.url);
      }

      if (!decision.redirect || !rubikcShouldRecoverCartLink(window.location.pathname, window.location.search)) {
        leave(decision);
        return;
      }

      var finished = false;

      function finish(cart) {
        if (finished) return;
        finished = true;

        var recovered = decision.url;

        try {
          recovered = rubikcRecoverCartLinkUrl(decision.url, cart);
          if (recovered === decision.url) recovered = rubikcRecoverCartLinkUrl(decision.url, rubikcShopifyCart);
        } catch (error) {
          recovered = decision.url;
        }

        leave({
          url: recovered,
          clearDiscountCookie: decision.clearDiscountCookie
        });
      }

      var timer = setTimeout(function () {
        finish(null);
      }, 3000);

      fetch('/cart.js' + (window.location.search || ''), {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
        cache: 'no-store'
      })
        .then(function (response) {
          return response && response.ok ? response.json() : null;
        })
        .then(function (cart) {
          clearTimeout(timer);
          finish(cart);
        })
        .catch(function () {
          clearTimeout(timer);
          finish(null);
        });
    })();
  </script>
{%- endif -%}
