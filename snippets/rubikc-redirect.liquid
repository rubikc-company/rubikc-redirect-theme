{%- comment -%}
  Content pages redirect to the Rubikc storefront URL.
  Account, cart, checkout, policies, gift cards, and Shopify checkpoints stay on this theme.
{%- endcomment -%}

{%- if part == 'style' -%}
  <style>
    html.rubikc-redirecting {
      background: #111111;
    }

    html.rubikc-redirecting body {
      visibility: hidden;
    }

    .rubikc-redirect {
      display: none;
    }

    html.rubikc-redirecting .rubikc-redirect {
      display: flex;
      visibility: visible;
      position: fixed;
      inset: 0;
      z-index: 2147483646;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 1.5rem;
      background: #111111;
      color: #f7f7f7;
      font-family: system-ui, sans-serif;
      text-align: center;
      text-decoration: none;
    }

    html.rubikc-redirecting .rubikc-redirect__brand {
      display: block;
      font-size: 1.25rem;
      letter-spacing: 0.04em;
    }

    html.rubikc-redirecting .rubikc-redirect__status {
      display: block;
      margin-top: 0.35rem;
      font-size: 0.875rem;
      opacity: 0.72;
    }
  </style>
{%- elsif part == 'notice' -%}
  {%- liquid
    assign rubikc_fallback_url = fallback_base | append: request.path
    if request.page_type == 'product'
      assign rubikc_fallback_url = rubikc_fallback_url | append: '#content-1'
    endif
  -%}
  <a class="rubikc-redirect" id="rubikc-redirect-link" href="{{ rubikc_fallback_url | escape }}">
    <span class="rubikc-redirect__brand">Rubikc</span>
    <span class="rubikc-redirect__status">{{ 'general.rubikc_redirect.continue' | t }}</span>
  </a>
  <script>
    if (window.rubikcRedirectUrl) {
      var rubikcRedirectLink = document.getElementById('rubikc-redirect-link');
      if (rubikcRedirectLink) rubikcRedirectLink.href = window.rubikcRedirectUrl;
    }
  </script>
{%- elsif part == 'script' -%}
  <script>
    /* @rubikc-redirect */
    function rubikcReadCookie(cookieHeader, name) {
      var parts = String(cookieHeader || '').split(';');
      var prefix = name + '=';

      for (var i = 0; i < parts.length; i++) {
        var cookie = parts[i].trim();
        if (cookie.indexOf(prefix) === 0) {
          var value = cookie.substring(prefix.length);
          try {
            return decodeURIComponent(value);
          } catch (error) {
            return value;
          }
        }
      }

      return '';
    }

    function rubikcPathSegments(pathname) {
      var parts = String(pathname || '/').split('/');
      var index = 1;

      if (parts[1] && /^[a-z]{2,3}(-[a-zA-Z]{2})?$/i.test(parts[1])) {
        index = 2;
      }

      return parts.slice(index);
    }

    function rubikcIsEssentialPath(pathname) {
      var segment = rubikcPathSegments(pathname)[0] || '';
      var essential = {
        account: true,
        cart: true,
        checkout: true,
        checkouts: true,
        challenge: true,
        checkpoint: true,
        throttle: true,
        apps: true,
        a: true,
        community: true,
        tools: true,
        discount: true,
        policies: true,
        gift_cards: true
      };

      return !!essential[segment];
    }

    function rubikcIsProductPath(pathname) {
      return rubikcPathSegments(pathname)[0] === 'products';
    }

    function rubikcResolveRedirect(input) {
      var redirectTarget = String(input.redirectTarget || '').trim();
      if (!redirectTarget || input.designMode) {
        return { redirect: false };
      }

      var search = input.search || '';
      var params = new URLSearchParams(search.charAt(0) === '?' ? search.slice(1) : search);
      var clearStay = false;
      var stayStored = !!input.stayStored;

      if (params.get('rubikc_stay_old') === '0') {
        clearStay = true;
        stayStored = false;
      } else if (params.has('rubikc_stay_old') || stayStored) {
        return {
          redirect: false,
          clearStay: false,
          storeStay: params.has('rubikc_stay_old')
        };
      }

      if (rubikcIsEssentialPath(input.pathname)) {
        return { redirect: false, clearStay: clearStay };
      }

      var target = redirectTarget;
      if (target.indexOf('//') === 0) {
        target = 'https:' + target;
      } else if (!/^https?:\/\//i.test(target)) {
        target = 'https://' + target;
      }

      var targetUrl;
      try {
        targetUrl = new URL(target);
      } catch (error) {
        return { redirect: false, clearStay: clearStay };
      }

      if (targetUrl.protocol !== 'http:' && targetUrl.protocol !== 'https:') {
        return { redirect: false, clearStay: clearStay };
      }

      if (String(input.hostname || '').toLowerCase() === targetUrl.hostname.toLowerCase()) {
        return { redirect: false, clearStay: clearStay };
      }

      var hash = input.hash || '';
      if (!hash && rubikcIsProductPath(input.pathname)) {
        hash = '#content-1';
      }

      var basePath = targetUrl.pathname.replace(/\/$/, '');
      if (basePath === '/') basePath = '';

      var destination = new URL(targetUrl.origin + basePath + (input.pathname || '/'));
      destination.search = search;
      destination.searchParams.delete('rubikc_stay_old');
      if (hash) destination.hash = hash;

      var discountCode = rubikcReadCookie(input.cookie, 'discount_code');
      var clearDiscountCookie = false;
      if (discountCode && !destination.searchParams.has('discount')) {
        destination.searchParams.append('discount', discountCode);
        clearDiscountCookie = true;
      }

      return {
        redirect: true,
        url: destination.toString(),
        clearDiscountCookie: clearDiscountCookie,
        clearStay: clearStay
      };
    }
    /* @rubikc-redirect-end */

    (function () {
      function reveal() {
        document.documentElement.classList.remove('rubikc-redirecting');
      }

      var stayStored = false;
      try {
        stayStored = window.sessionStorage.getItem('rubikc_stay_old') === '1';
      } catch (error) {
        stayStored = false;
      }

      var decision;
      try {
        decision = rubikcResolveRedirect({
          redirectTarget: {{ settings.redirect_url | json }},
          pathname: window.location.pathname,
          search: window.location.search,
          hash: window.location.hash,
          hostname: window.location.hostname,
          cookie: document.cookie,
          designMode: !!(window.Shopify && window.Shopify.designMode),
          stayStored: stayStored
        });
      } catch (error) {
        reveal();
        return;
      }

      try {
        if (decision.clearStay) window.sessionStorage.removeItem('rubikc_stay_old');
        if (decision.storeStay) window.sessionStorage.setItem('rubikc_stay_old', '1');
      } catch (error) {}

      if (!decision.redirect) {
        reveal();
        return;
      }

      if (decision.clearDiscountCookie) {
        document.cookie = 'discount_code=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT; SameSite=Lax';
      }

      window.rubikcRedirectUrl = decision.url;
      window.location.replace(decision.url);
    })();
  </script>
{%- endif -%}
